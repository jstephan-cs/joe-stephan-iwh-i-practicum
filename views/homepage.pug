doctype html
html
  head
    title= title
    link(rel="stylesheet", href="/css/style.css")
  body
    h1 Sports Cards
    a(href="/update-cobj") Add to this table
    table
      thead
        tr
          th Name
          th Sport
          th Year
      tbody
        each record in records
          tr
            td= record.properties.name
            td= record.properties.sport
            td= record.properties.year